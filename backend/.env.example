# ============================================================
# Rubicon Flask backend — environment configuration
# Copy to .env and fill in real values.
# ============================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-too-another-long-random-string
# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---
# Plain PostgreSQL 14+ — no extensions needed (embeddings are stored as native
# float8[] arrays and searched with NumPy cosine similarity).
DATABASE_URL=postgresql+psycopg2://rubicon:rubicon@localhost:5432/rubicon

# --- Storage backend: local | gcs | s3 ---
# Face intelligence is storage-agnostic; swap this without touching the ML layer.
STORAGE_BACKEND=local
# For STORAGE_BACKEND=local: where uploaded originals + derivatives live.
STORAGE_LOCAL_DIR=./storage
# Public base URL the frontend uses to load stored media (served by /media/*).
MEDIA_BASE_URL=http://localhost:5000/media
# For s3/gcs (only read when the matching backend is selected):
S3_BUCKET=
S3_REGION=
GCS_BUCKET=

# --- Face recognition ---
# InsightFace model pack. buffalo_l = ArcFace r100, 512-d embeddings.
FACE_MODEL=buffalo_l
FACE_EMBED_DIM=512
# Cosine similarity threshold for declaring a match (0..1). Higher = stricter.
FACE_MATCH_THRESHOLD=0.35
# Run detection on CPU by default; set to 1 if onnxruntime-gpu + CUDA present.
FACE_USE_GPU=0

# --- Google OAuth (Sign-in) ---
# From Google Cloud Console -> APIs & Services -> Credentials (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Google Photos Picker API (optional; manual photo import) ---
# The old Library API can no longer list a user's existing albums (Google, Mar 2025).
# The Picker API only returns items the user manually selects.
GOOGLE_PICKER_ENABLED=0

# --- Optional: keep Gemini available for caption/tagging enrichment ---
GEMINI_API_KEY=
