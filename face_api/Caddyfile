{$API_HOST} {
    encode gzip

    request_body {
        max_size 25MB
    }

    @backend path /api/* /media/*

    handle @backend {
        reverse_proxy backend:5000
    }

    @face_detect path /detect
    handle @face_detect {
        reverse_proxy face-api:8080
    }

    handle {
        respond "Not Found" 404
    }
}
